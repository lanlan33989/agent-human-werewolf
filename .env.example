# ---------- 分层开关（关键：本文件里第一个出现的值生效）----------
# 0 = 真实，1 = mock。想只验哪一层，就只把那一层设成 0。
# 例：先只验远场拾音 ⇒ MOCK_ASR=0，LLM/TTS 仍 1，这样不必等 LLM key 也能跑。
MOCK=0
MOCK_ASR=0
MOCK_LLM=1
MOCK_TTS=0
# ⚠️ 把 MOCK_LLM 设成 0 时要知道：它按层切换，不会自动让"对局里的 AI"变成真模型。
#    对局里 AI 的发言由 server.py 注入的 Agent 工厂决定，工厂会按 MOCK_LLM
#    自动选 LlmAgent 还是 RuleAgent —— 这一步已经接好，不需要手改。

# ---------- ASR ----------
# doubao（骨架，待填）| faster-whisper（本地，离线，无需 key）| qwen（阿里云百炼，云端）
# 模板默认给 faster-whisper：它不需要任何 key，抄走就能跑。
#   有百炼 key 就用 qwen（更快、黑话更准，见下面那一段），把 ASR 改成 qwen。
#   什么都不想接就先 MOCK_ASR=1。
ASR=faster-whisper
ASR_MODEL=small
# 直接指向本地模型目录（最省事，完全绕开 HuggingFace 的网络问题）
# 目录里应有 model.bin / config.json / tokenizer.json / vocabulary.txt
ASR_MODEL_PATH=<你的本地模型目录>
# 用 HuggingFace 缓存时：1 = 只用本地缓存不联网（有代理的机器必须设 1）
ASR_OFFLINE=1

# ---------- TTS ----------
# sapi（本地，离线零成本，**只有一个中文音色**）
# qwen（阿里云百炼 Qwen-TTS，**48 个音色**：法官一个、每个 AI 按人格各一个）
# doubao（云端骨架，待接）
# 把人声分不开的时候（"法官和玩家听起来一样"）就切 qwen —— 见下面那段。
TTS=sapi
SAPI_VOICE=ZH-CN
SAPI_RATE=2

# ---------- LLM（任何 OpenAI 兼容端点都行）----------
# 当前用 **DeepSeek 官方**（公网、无需隧道）。
# ⚠️ 模型**按 GET /v1/models 的权威清单选**，别照名字猜。2026-09-15 实测（各 3 次）：
#     deepseek-flash    2.28 秒  ← 选它（在清单里，且够快）
#     deepseek-v4-pro  11.45 秒  ← 在清单里，但太慢
#     deepseek-chat     0.97 秒  ← 最快，但**不在清单里**，不拿它当依据
# 备用（中科大校内，只在 iWAN 隧道内可用；实测每句 10~43 秒，限流 20 请求/分钟）：
#     LLM_BASE_URL=https://api.llm.ustc.edu.cn/v1 / LLM_MODEL=deepseek-v4-flash-ascend
# ⚠️ 三项都要填：缺任何一项都会在第一次调用时抛 RuntimeError。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# ---------- LLM 超时与重试 ----------
# 探针页沿用宽预算；对局路径单独一个更短的 —— 轮到某个 AI 说话时，
# 桌上没人能等 60 秒。超时会退化成本地套话，不会把一局卡死。
# 429 / 5xx 会先退避重试（0.8 / 1.6 / 3.2 秒），重试仍失败才退化 ——
# 那家文档明确要求不许静默吞掉 429/500。
LLM_TIMEOUT=60
LLM_TURN_TIMEOUT=20
LLM_RETRIES=3

# ---------- 阿里云百炼（DashScope）ASR：Qwen-ASR ----------
# 用的时候把上面的 ASR 改成 qwen。走 OpenAI 兼容协议（chat/completions + base64 音频）。
# 2026-09-19 实测（4 段夹具，每段 5 秒左右）：1.3 ~ 1.5 秒/段，**逐字全对**
#   （含黑话：金水 / 查杀 / 平安夜 / 解药）。
# ⚠️ 同一模型的 DashScope 原生协议要 22.3 秒（慢 15 倍）⇒ 固定用兼容协议，别换。
# ⚠️ 这个服务**不接受任何文本输入**：system 里塞"黑话词表"会 400
#   （所以本地 whisper 那条 initial_prompt 在云端没有对应物）。
DASHSCOPE_API_KEY=
# 官方文档用的是业务空间专属域名 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 公共域名仍可用（我们默认用这个，省一步 WorkspaceId）。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
DASHSCOPE_TIMEOUT=15
# ⚠️ 它是**读超时**（httpx 的 timeout 按每次读写算），不是总时长上限：
#    实测有长尾（重启后第一次 16.3 秒）仍然成功返回 —— 跑长音频时别指望它兜总时长。
# 语种：中文局就填 zh（文档说"语种确定时指定能提准确率"，混合语种才留空）
DASHSCOPE_ASR_LANG=zh
DASHSCOPE_RETRIES=2

# ---------- 流式 ASR（realtime，边走边出字）----------
# 走 /ws/asr 中继（key 留在服务端）。实测：整段上传要等说完 1.2~1.4 秒才出字，
# 流式首字 0.49 秒（音频 5.2 秒）。前端会自动优先用它，起不来就回落成整段上传。
DASHSCOPE_REALTIME_MODEL=qwen3-asr-flash-realtime

# ---------- 百炼 TTS（多音色）----------
# ⚠️ 单独一把 key（按模型授权）。留空回落到 DASHSCOPE_API_KEY。
# ⚠️ model 必须用**清单里**的名字：qwen3-tts-flash（实测 1.05 秒/句，24k WAV）。
#    控制台的产品名（如 qwen-audio-3.1-tts-flash）拿去调 API 会 400。
DASHSCOPE_TTS_API_KEY=
DASHSCOPE_TTS_MODEL=qwen3-tts-flash
DASHSCOPE_TTS_VOICE=Ethan
DASHSCOPE_TTS_TIMEOUT=30
DASHSCOPE_TTS_RETRIES=2

# ---------- 火山引擎语音技术（ASR / TTS 是骨架，待填）----------
VOLC_ASR_APPID=
VOLC_ASR_TOKEN=
VOLC_ASR_CLUSTER=

VOLC_TTS_APPID=
VOLC_TTS_TOKEN=
VOLC_TTS_VOICE=

# ---------- 调试 ----------
# 1 = 把最近一次上传的音频存成 _last_upload.wav（排查拾音问题时很有用）
SAVE_UPLOADS=1
