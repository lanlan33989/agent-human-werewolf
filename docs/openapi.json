    "/api/game/{gid}/public": {
      "get": {
        "tags": [
          "game"
        ],
        "summary": "Public",
        "description": "⚠️ 这是**唯一会推进状态机的 GET** —— 它会替 AI 干活（最多 POLL_BUDGET 秒）。\n\n为什么必须这样：AI 的决策要调模型，大人数局一次跑不完一个回合。\n如果只有 POST /act 才推进，那 13 人局会有几十秒完全没反应。\n让它在这里推，开局就能立刻返回、桌面自己长出来。\n（`pending == \"working\"` 就表示\"还在推进\"，前端照常继续轮询即可。）",
        "operationId": "public_api_game__gid__public_get",
        "parameters": [
          {
            "name": "gid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Gid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Public Api Game  Gid  Public Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
