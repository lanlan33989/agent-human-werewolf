    "/api/game/rules": {
      "get": {
        "tags": [
          "game"
        ],
        "summary": "Rules",
        "description": "自动组局的规则。界面用它把「你选的 N 人 = 几狼几神几民」直接显示给玩家。\n\n放在服务端而不是前端写死：规则只有一份，改的时候两边不会漂移。",
        "operationId": "rules_api_game_rules_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Rules Api Game Rules Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/game/{gid}/scoreboard": {
      "get": {
        "tags": [
          "game"
        ],
        "summary": "Scoreboard",
        "description": "这一局的**六维指标 + 人机对比**（测量层，批四）。\n\n⚠️ 它读的是**全知状态**（含所有人的身份），所以只给复盘/指标/榜单看 ——\n   **绝不能**把它塞进任何 AI 的 prompt（那等于把 L3 交给 AI）。\n还没打完的局也能查（就是\"截至此刻\"的快照），`outcome.ended` 说明它完没完。",
        "operationId": "scoreboard_api_game__gid__scoreboard_get",
        "parameters": [
          {
            "name": "gid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Gid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Scoreboard Api Game  Gid  Scoreboard Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/game/stats": {
      "get": {
        "tags": [
          "game"
        ],
        "summary": "Stats",
        "description": "跨局聚合（榜单 v0）。**按档分组** —— 不分档的胜率没有意义：\n不同档的 AI 根本不是一回事（赌注措辞、说话要求都不同）。\n\n诚实边界：只统计**内存里还在**的局（探针阶段不做持久化）。\n真正的榜单要等结构化日志落盘（批次 5/6）。",
        "operationId": "stats_api_game_stats_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Stats Api Game Stats Get"
                }
              }
            }
          }
        }
      }
    },
